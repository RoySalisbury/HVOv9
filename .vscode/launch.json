    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Debug: HVO.SkyMonitorV5.RPi",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:skymonitorv5:debug",
            "program": "${workspaceFolder}/src/HVO.SkyMonitorV5/HVO.SkyMonitorV5.RPi/bin/Debug/net10.0/HVO.SkyMonitorV5.RPi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/HVO.SkyMonitorV5/HVO.SkyMonitorV5.RPi/bin/Debug/net10.0",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "DOTNET_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://0.0.0.0:7151;http://0.0.0.0:5136"
            },
            "stopAtEntry": false,
            "console": "internalConsole",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on\\s+https://\\S+:(\\d+)",
                "uriFormat": "https://localhost:%s"
            }
        },
        {
            "name": ".NET Debug (HTTP only): HVO.SkyMonitorV5.RPi",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:skymonitorv5:debug",
            "program": "${workspaceFolder}/src/HVO.SkyMonitorV5/HVO.SkyMonitorV5.RPi/bin/Debug/net10.0/HVO.SkyMonitorV5.RPi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/HVO.SkyMonitorV5/HVO.SkyMonitorV5.RPi/bin/Debug/net10.0",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "DOTNET_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://0.0.0.0:5136"
            },
            "stopAtEntry": false,
            "console": "internalConsole",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on\\s+http://\\S+:(\\d+)",
                "uriFormat": "http://localhost:%s"
            }
        },
        {
            "name": ".NET Release: HVO.SkyMonitorV5.RPi",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:skymonitorv5:release",
            "program": "${workspaceFolder}/src/HVO.SkyMonitorV5/HVO.SkyMonitorV5.RPi/bin/Release/net10.0/HVO.SkyMonitorV5.RPi.dll",
            "args": [],
