{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "HVO.SkyMonitorV5.RPi.Pipeline.FrameFilterPipeline": "Warning",
      "HVO.SkyMonitorV5.RPi.Pipeline.RollingFrameStacker": "Warning",
      "HVO.SkyMonitorV5.RPi.Pipeline.Filters.CardinalDirectionsFilter": "Warning",
      "HVO.SkyMonitorV5.RPi.Pipeline.Filters.CelestialAnnotationsFilter": "Warning",
      "HVO.SkyMonitorV5.RPi.Pipeline.Filters.ConstellationFigureFilter": "Warning",
      "HVO.SkyMonitorV5.RPi.Pipeline.Filters.CircularApertureMaskFilter": "Warning",
      "HVO.SkyMonitorV5.RPi.Cameras.MockCameraAdapter": "Warning",
      "HVO.SkyMonitorV5.RPi.Services.RigRuntimeUpdater": "Warning",
      "HVO.SkyMonitorV5.RPi.Cameras.Acquisition.RigAcquisitionAdapter": "Warning",
      "HVO.SkyMonitorV5.RPi.Services.EquipmentConfigurationService": "Warning",
      "HVO.SkyMonitorV5.RPi": "Warning"
    }
  },
  "ImageHistory": {
    "EnableArchive": true
  },
  "SkiaPipelineFeatures": {
    "EnableRawLinearPayloads": true,
    "EnableProcessedFrameEncoder": true
  },
  "SkyMonitor": {
    "Logging": {
      "Directory": "/workspaces/HVOv9/logs"
    },
    "Diagnostics": {
      "LogFirstChanceExceptions": false
    },
    "Data": {
      "OverrideRootPath": "/workspaces/HVOv9/datastores"
    }
  },
  "CameraPipeline": {
    "Overrides": {
      "EnableStacking": true,
      "StackingFrameCount": 4,
      "StackingBufferMinimumFrames": 24,
      "StackingBufferIntegrationSeconds": 120,
      "BackgroundStackerEnabled": true,
      "EnableImageOverlays": true,
      "FrameFilters": [
        "CardinalDirections",
        "ConstellationFigures",
        "CelestialAnnotations",
        "OverlayText",
        "CircularApertureMask"
      ],
      "DisableSensorNoise": false,
      "SensorNoiseScale": 0.22
    },
    "CelestialAnnotations": {
      "LabelFontSize": 12.0,
      "StarRingRadius": 6.0,
      "PlanetRingRadius": 10.0,
      "DeepSkyRingRadius": 12.0,
      "StarLabelColor": "#EBF5FF",
      "PlanetLabelColor": "#FFE8C5",
      "DeepSkyLabelColor": "#F0E4FF"
    }
  },
  "FrameExport": {
    "Raw": {
      "Enabled": true,
      "PayloadScope": "ArchiveOnly",
      "ArchiveEncoding": {
        "Format": "Fits",
        "Quality": 100,
        "FitsOptions": {
          "BitDepth": "U16",
          "ImageFormat": "Mono",
          "Compression": "None",
          "UnsignedU16": true,
          "WriteChecksum": true
        }
      },
      "DeliveryEncoding": null,
      "Filesystem": [
        {
          "Enabled": true,
          "RootPath": null,
          "Prefix": null,
          "IncludeMetadataManifest": true
        }
      ],
      "S3": [
        {
          "Enabled": false,
          "Bucket": null,
          "Prefix": null,
          "Endpoint": null,
          "AccessKey": null,
          "SecretKey": null,
          "Region": "us-west-2",
          "UseSsl": true,
          "EmitMetadataHeaders": true,
          "EmitJsonManifest": true
        }
      ]
    },
    "Processed": {
      "Enabled": true,
      "PayloadScope": "ArchiveOnly",
      "ArchiveEncoding": {
        "Format": "Jpeg",
        "Quality": 95,
        "FitsOptions": null
      },
      "DeliveryEncoding": null,
      "Filesystem": [
        {
          "Enabled": true,
          "RootPath": null,
          "Prefix": "processed",
          "IncludeMetadataManifest": true
        }
      ],
      "S3": [
        {
          "Enabled": false,
          "Bucket": null,
          "Prefix": null,
          "Endpoint": null,
          "AccessKey": null,
          "SecretKey": null,
          "Region": "us-west-2",
          "UseSsl": true,
          "EmitMetadataHeaders": true,
          "EmitJsonManifest": true
        }
      ]
    }
  }
}