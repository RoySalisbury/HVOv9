@using HVO.SkyMonitorV5.RPi.Models.Optics
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<div class="container py-4 text-light">
    <header class="config-toolbar">
        <div class="config-toolbar__info">
            <h1 class="config-toolbar__title">Rig Configuration</h1>
            <p class="config-toolbar__subtitle">Manage rig catalog entries and adapter-ready pairings for camera adapters.</p>
        </div>
        <div class="config-toolbar__actions">
            <button type="button"
                    class="btn btn-sm btn-outline-light"
                    @onclick="BeginCreate"
                    disabled="@(!CanBeginCreate)">
                <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                New Rig
            </button>
            <button type="button"
                    class="btn btn-sm btn-outline-info"
                    @onclick="ReloadCatalogAsync"
                    disabled="@(!CanReloadCatalog)">
                <i class="bi bi-arrow-clockwise me-2" aria-hidden="true"></i>
                Refresh Catalog
            </button>
        </div>
        @if (IsBusy)
        {
            <div class="config-toolbar__status text-muted">
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                Working…
            </div>
        }
        else
        {
            <div class="config-toolbar__status text-muted">@GetToolbarSelectionStatus()</div>
        }
    </header>

    <div class="row g-4">
        <div class="col-12">
            <section class="card bg-dark border-secondary shadow-sm config-card">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h5 mb-1 d-flex align-items-center gap-2 config-card__title">Rig Catalog
                            <span class="label-tooltip" role="img" aria-label="Manage camera and optics pairings used when assigning adapters." title="Manage camera and optics pairings used when assigning adapters.">
                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                            </span>
                        </h2>
                        <p class="mb-0 text-muted small">Manage all-sky rig pairings that can be bound to camera adapters.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                        <div class="input-group input-group-sm rig-filter">
                            <span class="input-group-text bg-transparent border-secondary text-muted">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search"
                                   class="form-control"
                                   placeholder="Filter rigs…"
                                   @bind="SearchText"
                                   @bind:event="oninput"
                                   aria-label="Filter rigs by name, key, camera, or optics" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_activeRigKey))
                        {
                            <span class="badge bg-success-subtle text-success-emphasis">Active @_activeRigKey</span>
                        }
                        <button type="button"
                                class="btn btn-outline-light btn-sm config-card__collapse"
                                @onclick="ToggleCatalogSection"
                                aria-expanded="@(!_catalogCollapsed)"
                                aria-controls="rig-catalog-card-body"
                                title='@GetCollapseButtonTitle("Rig catalog section", _catalogCollapsed)'>
                            <i class="@GetCollapseIconCss(_catalogCollapsed)" aria-hidden="true"></i>
                            <span class="visually-hidden">@GetCollapseButtonTitle("Rig catalog section", _catalogCollapsed)</span>
                        </button>
                    </div>
                </div>
                <div id="rig-catalog-card-body"
                     class="card-body @GetCollapseCss(_catalogCollapsed)"
                     aria-hidden="@_catalogCollapsed">
                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @_errorMessage
                        </div>
                        <button type="button"
                                class="btn btn-sm btn-outline-info"
                                @onclick="ReloadCatalogAsync"
                                disabled="@(!CanReloadCatalog)">
                            <i class="bi bi-arrow-clockwise me-2"></i>
                            Retry Load
                        </button>
                    }
                    else if (_isLoading && FilteredRigs.Count == 0)
                    {
                        <div class="d-flex align-items-center gap-3 text-muted py-2">
                            <div class="spinner-border text-secondary" role="status">
                                <span class="visually-hidden">Loading rig catalog…</span>
                            </div>
                            <span>Loading rig catalog…</span>
                        </div>
                    }
                    else if (FilteredRigs.Count == 0)
                    {
                        <p class="text-muted">@GetEmptyFilterMessage()</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Name</th>
                                        <th scope="col">Key</th>
                                        <th scope="col">Camera</th>
                                        <th scope="col">Optics</th>
                                        <th scope="col" class="text-center">Boresight (Alt / Az)</th>
                                        <th scope="col" class="text-center">Active</th>
                                        <th scope="col" class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rig in FilteredRigs)
                                    {
                                        var isSelected = _editModel?.Id == rig.Id && rig.Id != 0;
                                        <tr @onclick="() => HandleRowSelection(rig)"
                                            class="@(isSelected ? "table-active" : string.Empty)">
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span>@rig.DisplayName</span>

                                                </div>
                                            </td>
                                            <td><code>@rig.Key</code></td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span>@rig.CameraDisplayName</span>
                                                    <small class="text-muted">@rig.CameraKey</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span>@rig.OpticsDisplayName</span>
                                                    <small class="text-muted">@rig.OpticsKey</small>
                                                </div>
                                            </td>
                                            <td class="text-center">@($"{rig.BoresightAltitudeDegrees:F1}° / {rig.BoresightAzimuthDegrees:F1}°")</td>
                                            <td class="text-center">
                                                @if (rig.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success-emphasis">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Disabled</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group" role="group" aria-label="Rig actions">
                                                    <button type="button"
                                                            class="btn btn-outline-light btn-sm d-flex align-items-center gap-2"
                                                            title="Edit rig"
                                                            @onclick="(() => SelectRig(rig))"
                                                            @onclick:stopPropagation="true"
                                                            disabled="@(_isSaving)">
                                                        <i class="bi bi-pencil-square"></i>
                                                        <span>Edit</span>
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-outline-success btn-sm d-flex align-items-center gap-2"
                                                            title="Activate rig"
                                                            @onclick="(() => SetActiveAsync(rig, true))"
                                                            @onclick:stopPropagation="true"
                                                            disabled="@(_isSaving || rig.IsActive)">
                                                        <i class="bi bi-toggle-on"></i>
                                                        <span>Activate</span>
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-outline-warning btn-sm d-flex align-items-center gap-2"
                                                            title="Disable rig"
                                                            @onclick="(() => SetActiveAsync(rig, false))"
                                                            @onclick:stopPropagation="true"
                                                            disabled="@(_isSaving || !rig.IsActive)">
                                                        <i class="bi bi-toggle-off"></i>
                                                        <span>Disable</span>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-12">
            <section class="card bg-dark border-secondary shadow-sm config-card">
                <div class="card-header border-secondary d-flex justify-content-between align-items-start">
                    <div>
                        <h2 class="h5 mb-1 d-flex align-items-center gap-2 config-card__title">Configure Rig
                            <span class="label-tooltip" role="img" aria-label="Adjust camera, optics, and boresight data for the selected rig." title="Adjust camera, optics, and boresight data for the selected rig.">
                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                            </span>
                        </h2>
                        <p class="mb-0 text-muted small">Edit rig metadata and activation state used by downstream adapters.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                        @if (_editModel is not null)
                        {
                            if (_editModel.Id > 0)
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis mt-1">ID @_editModel.Id · Rev @_editModel.Revision</span>
                            }
                            else
                            {
                                <span class="badge bg-info-subtle text-info-emphasis mt-1">New Rig Draft</span>
                            }
                        }
                        <button type="button"
                                class="btn btn-outline-light btn-sm config-card__collapse"
                                @onclick="ToggleEditorSection"
                                aria-expanded="@(!_editorCollapsed)"
                                aria-controls="rig-editor-card-body"
                                title='@GetCollapseButtonTitle("Rig editor section", _editorCollapsed)'>
                            <i class="@GetCollapseIconCss(_editorCollapsed)" aria-hidden="true"></i>
                            <span class="visually-hidden">@GetCollapseButtonTitle("Rig editor section", _editorCollapsed)</span>
                        </button>
                    </div>
                </div>
                <div id="rig-editor-card-body"
                     class="card-body @GetCollapseCss(_editorCollapsed)"
                     aria-hidden="@_editorCollapsed">
                    @if (!string.IsNullOrWhiteSpace(_successMessage))
                    {
                        <div class="alert alert-success" role="status">
                            @_successMessage
                        </div>
                    }

                    @if (_editContext is null || _editModel is null)
                    {
                        <p class="text-muted mb-0">Select a rig to edit or create a new entry.</p>
                    }
                    else
                    {
                        <EditForm EditContext="@_editContext">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="rig-display" class="form-label config-label">Display Name
                                        <span class="label-tooltip" role="img" aria-label="Friendly rig name shown throughout the dashboard." title="Friendly rig name shown throughout the dashboard.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputText id="rig-display" class="form-control" @bind-Value="_editModel.DisplayName" />
                                </div>
                                <div class="col-md-6">
                                    <label for="rig-key" class="form-label config-label">Rig Key
                                        <span class="label-tooltip" role="img" aria-label="Stable identifier used by adapters and service configuration." title="Stable identifier used by adapters and service configuration.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    @if (_editModel.Id == 0)
                                    {
                                        <InputText id="rig-key"
                                                   class="form-control"
                                                   @bind-Value="_editModel.Key"
                                                   autocomplete="off"
                                                   inputmode="text"
                                                   pattern="^[A-Za-z0-9_-]+$" />
                                        <div class="form-text">Stable identifier used by adapters. Letters, numbers, hyphen, and underscore only.</div>
                                    }
                                    else
                                    {
                                        <InputText id="rig-key" class="form-control" @bind-Value="_editModel.Key" readonly />
                                    }
                                </div>
                                <div class="col-md-6">
                                    <label for="rig-camera" class="form-label config-label">Camera
                                        <span class="label-tooltip" role="img" aria-label="Select the catalog camera paired with this rig." title="Select the catalog camera paired with this rig.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputSelect id="rig-camera" class="form-select" @bind-Value="_editModel.CameraKey">
                                        @foreach (var camera in _cameras)
                                        {
                                            <option value="@camera.Key">@camera.DisplayName (@camera.Key)</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-md-6">
                                    <label for="rig-optics" class="form-label config-label">Optics
                                        <span class="label-tooltip" role="img" aria-label="Select the catalog optics profile that matches this rig." title="Select the catalog optics profile that matches this rig.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputSelect id="rig-optics" class="form-select" @bind-Value="_editModel.OpticsKey">
                                        @foreach (var optics in _optics)
                                        {
                                            <option value="@optics.Key">@optics.DisplayName (@optics.Key)</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-md-3">
                                    <label for="rig-alt" class="form-label config-label">Boresight Altitude (°)
                                        <span class="label-tooltip" role="img" aria-label="Altitude angle above the horizon for the rig boresight." title="Altitude angle above the horizon for the rig boresight.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputNumber TValue="double" id="rig-alt" class="form-control" @bind-Value="_editModel.BoresightAltitudeDegrees" step="0.1" min="0" max="90" />
                                </div>
                                <div class="col-md-3">
                                    <label for="rig-az" class="form-label config-label">Boresight Azimuth (°)
                                        <span class="label-tooltip" role="img" aria-label="Compass direction for the rig boresight measured clockwise from north." title="Compass direction for the rig boresight measured clockwise from north.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputNumber TValue="double" id="rig-az" class="form-control" @bind-Value="_editModel.BoresightAzimuthDegrees" step="0.1" min="0" max="360" />
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <InputCheckbox id="rig-active" class="form-check-input" @bind-Value="_editModel.IsActive" />
                                        <label for="rig-active" class="form-check-label text-light d-inline-flex align-items-center gap-2">Active by default
                                            <span class="label-tooltip" role="img" aria-label="Mark this rig as the default active configuration." title="Mark this rig as the default active configuration.">
                                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-4">
                                <button type="button" class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@(!CanSaveSelection)">
                                    <i class="bi bi-save me-2"></i>
                                    Save Changes
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-light" @onclick="CancelEditAsync" disabled="@(!CanCancelEdit)">
                                    <i class="bi bi-x-circle me-2"></i>
                                    Cancel
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="DeleteAsync" disabled="@(!CanDeleteSelection)">
                                    <i class="bi bi-trash me-2"></i>
                                    Delete
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </section>
        </div>
    </div>
</div>
