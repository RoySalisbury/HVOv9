@page "/monitor"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Web

<PageTitle>SkyMonitor v5 · Monitor</PageTitle>

<section class="hero gradient-overlay py-5">
    <div class="container">
        <div class="row align-items-center text-light">
            <div class="col-lg-8">
                <h1 class="display-4 fw-semibold">Observatory Monitor</h1>
                <p class="lead mb-0">Live all-sky imagery and capture telemetry from the observatory deck.</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <span class="status-badge @StatusBadgeClass">
                    <i class="bi bi-circle-fill me-2"></i>@StatusText
                </span>
                <div class="refresh-hint mt-2">
                    Updating every 10 seconds
                </div>
            </div>
        </div>
    </div>
</section>

@if (_status is null)
{
    <section class="container py-5 text-center text-light">
        <div class="spinner-border text-info" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-4 mb-0">Waiting for the first frame from the capture pipeline...</p>
    </section>
}
else
{
    <section class="container-fluid py-4 content-section">
        <div class="row g-4">
            <div class="col-12 col-xl-6">
                <div class="frame-card">
                    <header class="frame-card__header">
                        <i class="bi bi-magic"></i>
                        <span>Processed Frame</span>
                    </header>
                    @if (ProcessedImageSource is null)
                    {
                        <div class="frame-card__placeholder">
                            <i class="bi bi-images"></i>
                            <span>No processed frame available yet.</span>
                        </div>
                    }
                    else
                    {
                        @if (ProcessedFrameDetailUri is not null)
                        {
                            <a href="@ProcessedFrameDetailUri" class="frame-card__image-link">
                                <img src="@ProcessedImageSource" alt="Latest processed frame" class="frame-card__image" />
                            </a>
                        }
                        else
                        {
                            <div class="frame-card__image-link">
                                <img src="@ProcessedImageSource" alt="Latest processed frame" class="frame-card__image" />
                            </div>
                        }
                        <div class="frame-card__actions">
                            @if (ProcessedFrameDetailUri is not null)
                            {
                                <a href="@ProcessedFrameDetailUri" class="frame-card__action-link">
                                    <i class="bi bi-info-circle"></i>
                                    <span>Open detail view</span>
                                </a>
                            }
                        </div>
                    }
                    <footer class="frame-card__meta">
                        <span class="frame-card__meta-label">Overlays</span>
                        <span class="frame-card__meta-value frame-card__meta-value--overlays">@OverlayStatusText</span>
                    </footer>
                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="frame-card">
                    <header class="frame-card__header">
                        <i class="bi bi-camera"></i>
                        <span>Raw Frame</span>
                    </header>
                    @if (RawImageDisplaySource is null)
                    {
                        <div class="frame-card__placeholder">
                            <i class="bi bi-images"></i>
                            <span>No raw frame captured yet.</span>
                        </div>
                    }
                    else
                    {
                        @if (RawFrameDetailUri is not null)
                        {
                            <a href="@RawFrameDetailUri" class="frame-card__image-link">
                                <img src="@RawImageDisplaySource" alt="Latest raw frame" class="frame-card__image" />
                            </a>
                        }
                        else
                        {
                            <div class="frame-card__image-link">
                                <img src="@RawImageDisplaySource" alt="Latest raw frame" class="frame-card__image" />
                            </div>
                        }
                        <div class="frame-card__actions">
                            @if (RawFrameDetailUri is not null)
                            {
                                <a href="@RawFrameDetailUri" class="frame-card__action-link">
                                    <i class="bi bi-info-circle"></i>
                                    <span>Open detail view</span>
                                </a>
                            }
                        </div>
                    }
                    <footer class="frame-card__meta">
                        <span class="frame-card__meta-label">Exposure</span>
                        <span class="frame-card__meta-value">@ExposureSummary</span>
                    </footer>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-1 status-grid">
            <div class="col-12 col-lg-6 col-xl-3">
                <div class="status-card">
                    <header class="status-card__header">
                        <i class="bi bi-clock-history"></i>
                        <span>Capture Timeline</span>
                    </header>
                    <dl class="status-card__list">
                        <div class="status-card__item">
                            <dt>Last Frame</dt>
                            <dd>@LastFrameTimestampText</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Total Integration</dt>
                            <dd>@TotalIntegrationSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Pipeline Time</dt>
                            <dd>@PipelineProcessingSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Configuration</dt>
                            <dd>Stacking: @StackingSummary</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <div class="col-12 col-lg-6 col-xl-3">
                <div class="status-card">
                    <header class="status-card__header">
                        <i class="bi bi-gear-wide-connected"></i>
                        <span>Camera</span>
                    </header>
                    <dl class="status-card__list">
                        <div class="status-card__item">
                            <dt>Manufacturer</dt>
                            <dd>@_status.Camera.Manufacturer</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Model</dt>
                            <dd>@_status.Camera.Model</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Adapter</dt>
                            <dd>@_status.Camera.AdapterName</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Hardware Capabilities</dt>
                            <dd>@CameraHardwareCapabilitiesText</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Rig</dt>
                            <dd>@RigNameText</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Sensor</dt>
                            <dd>@SensorSummaryText</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Optics</dt>
                            <dd>@LensSummaryText</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <div class="col-12 col-lg-6 col-xl-3">
                <div class="status-card">
                    <header class="status-card__header">
                        <i class="bi bi-info-circle"></i>
                        <span>Pipeline</span>
                    </header>
                    <dl class="status-card__list">
                        <div class="status-card__item">
                            <dt>Configuration Version</dt>
                            <dd>@ConfigurationVersion</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Pipeline Capabilities</dt>
                            <dd>@PipelineCapabilitiesText</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Stack</dt>
                            <dd>@FramesStackedSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Background Worker</dt>
                            <dd>@BackgroundWorkerSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Queue Depth</dt>
                            <dd>@BackgroundQueueDepthSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Peak Depth</dt>
                            <dd>@BackgroundQueuePeakSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Queue Memory</dt>
                            <dd>@BackgroundQueueMemorySummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Queue Latency</dt>
                            <dd>@BackgroundQueueLatencySummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Avg Processing</dt>
                            <dd>@BackgroundProcessingAverageSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Drops</dt>
                            <dd>@BackgroundDropSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Last Completed</dt>
                            <dd>@BackgroundLastCompletedSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Capture Pacing</dt>
                            <dd>@CapturePacingSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Pacing Pressure</dt>
                            <dd>@CapturePacingPressureSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Penalty</dt>
                            <dd>@CapturePacingPenaltySummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Pacing Updated</dt>
                            <dd>@CapturePacingUpdatedSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Async Queue</dt>
                            <dd>@ProcessingQueueSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Queue Backpressure</dt>
                            <dd>@ProcessingQueueBackpressureSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Processing Times</dt>
                            <dd>@ProcessingQueueProcessingSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Queue Updated</dt>
                            <dd>@ProcessingQueueUpdatedSummary</dd>
                        </div>
                        <div class="status-card__item">
                            <dt>Filters</dt>
                            <dd>
                                @if (AppliedFilters.Count > 0)
                                {
                                    <div class="filter-chip-list">
                                        @foreach (var filter in AppliedFilters)
                                        {
                                            <span class="filter-chip">@filter</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @PipelineFiltersSummary
                                }
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <div class="col-12 col-lg-6 col-xl-3">
                <div class="status-card">
                    <header class="status-card__header">
                        <i class="bi bi-sliders"></i>
                        <span>Exposure Profiles</span>
                    </header>
                    @if (ExposureProfiles is null)
                    {
                        <div class="status-card__empty">
                            <i class="bi bi-dash-circle"></i>
                            <span>Exposure configuration not available.</span>
                        </div>
                    }
                    else
                    {
                        <dl class="status-card__list">
                            <div class="status-card__item">
                                <dt>Day</dt>
                                <dd>
                                    <div class="status-card__subline">@DayExposureProfileExposureSummary</div>
                                    <div class="status-card__subline">@DayExposureProfileGainSummary</div>
                                </dd>
                            </div>
                            <div class="status-card__item">
                                <dt>Night</dt>
                                <dd>
                                    <div class="status-card__subline">@NightExposureProfileExposureSummary</div>
                                    <div class="status-card__subline">@NightExposureProfileGainSummary</div>
                                </dd>
                            </div>
                        </dl>
                    }
                </div>
            </div>

            <div class="col-12 col-lg-6 col-xl-3">
                <div class="status-card">
                    <header class="status-card__header">
                        <i class="bi bi-sunrise"></i>
                        <span>Exposure Analysis</span>
                    </header>
                    @if (ExposureAnalysis is null)
                    {
                        <div class="status-card__empty">
                            <i class="bi bi-activity"></i>
                            <span>Awaiting first analysis result.</span>
                        </div>
                    }
                    else
                    {
                        <dl class="status-card__list">
                            <div class="status-card__item">
                                <dt>Last Analysis</dt>
                                <dd>@ExposureAnalysisTimestampText</dd>
                            </div>
                            <div class="status-card__item">
                                <dt>Lighting</dt>
                                <dd>@ExposureLightingDescription</dd>
                            </div>
                            <div class="status-card__item">
                                <dt>Luminance</dt>
                                <dd>@ExposureLuminanceSummary</dd>
                            </div>
                            <div class="status-card__item">
                                <dt>Recommendation</dt>
                                <dd>@ExposureRecommendationSummary</dd>
                            </div>
                            <div class="status-card__item">
                                <dt>Overrides</dt>
                                <dd>
                                    <div class="status-card__subline">@DayExposureOverrideSummary</div>
                                    <div class="status-card__subline">@NightExposureOverrideSummary</div>
                                </dd>
                            </div>
                        </dl>
                        @if (!string.IsNullOrWhiteSpace(ExposureAnalysisNotes))
                        {
                            <div class="status-card__note">
                                <i class="bi bi-journal-text"></i>
                                <span>@ExposureAnalysisNotes</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="col-12 col-lg-6 col-xl-3">
                <div class="status-card">
                    <header class="status-card__header">
                        <i class="bi bi-cloud-upload"></i>
                        <span>Remote Dispatch</span>
                    </header>
                    @if (RemoteDispatchStatusData is null)
                    {
                        <div class="status-card__empty">
                            <i class="bi bi-dash-circle"></i>
                            <span>Remote publishing disabled.</span>
                        </div>
                    }
                    else
                    {
                        <dl class="status-card__list">
                            <div class="status-card__item">
                                <dt>Mode</dt>
                                <dd>@RemoteDispatchModeSummary</dd>
                            </div>
                            <div class="status-card__item">
                                <dt>Outcome</dt>
                                <dd>@RemoteDispatchOutcomeSummary</dd>
                            </div>
                            <div class="status-card__item">
                                <dt>Success Rate</dt>
                                <dd>@RemoteDispatchSuccessRateSummary</dd>
                            </div>
                            <div class="status-card__item">
                                <dt>Attempts</dt>
                                <dd>@RemoteDispatchAttemptsSummary</dd>
                            </div>
                            <div class="status-card__item">
                                <dt>Latency</dt>
                                <dd>@RemoteDispatchLatencySummary</dd>
                            </div>
                            <div class="status-card__item">
                                <dt>Last Latency</dt>
                                <dd>@RemoteDispatchLastLatencySummary</dd>
                            </div>
                            <div class="status-card__item">
                                <dt>Last Frame</dt>
                                <dd>@RemoteDispatchCapturedSummary</dd>
                            </div>
                            <div class="status-card__item">
                                <dt>Last Payload</dt>
                                <dd>@RemoteDispatchLastPayloadSummary</dd>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(RemoteDispatchFormatsSummary))
                            {
                                <div class="status-card__item">
                                    <dt>Formats</dt>
                                    <dd>@RemoteDispatchFormatsSummary</dd>
                                </div>
                            }
                            <div class="status-card__item">
                                <dt>Telemetry Updated</dt>
                                <dd>@RemoteDispatchTelemetryUpdatedSummary</dd>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(RemoteDispatchMessage))
                            {
                                <div class="status-card__item">
                                    <dt>Details</dt>
                                    <dd>@RemoteDispatchMessage</dd>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(RemoteDispatchError))
                            {
                                <div class="status-card__item">
                                    <dt>Error</dt>
                                    <dd class="text-danger">@RemoteDispatchError</dd>
                                </div>
                            }
                        </dl>
                    }
                </div>
            </div>
        </div>
    </section>
}
