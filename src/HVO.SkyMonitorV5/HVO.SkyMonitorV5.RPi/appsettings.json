{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "HVO.SkyMonitorV5.RPi.Data.SkyMonitorRepository": "Warning",
      "HVO.SkyMonitorV5.RPi.Pipeline.Filters.CelestialAnnotationsFilter": "Warning",
      "HVO.SkyMonitorV5.RPi.HostedServices.AllSkyCaptureService": "Warning",
      "HVO.SkyMonitorV5.RPi.Pipeline.FrameFilterPipeline": "Warning",
      "HVO.SkyMonitorV5.RPi.Pipeline.RollingFrameStacker": "Warning",
      "HVO.SkyMonitorV5.RPi.Services.RigRuntimeUpdater": "Warning",
      "HVO.SkyMonitorV5.RPi.Cameras.Acquisition.RigAcquisitionAdapter": "Debug",
      "HVO.SkyMonitorV5.RPi.Services.EquipmentConfigurationService": "Debug"
    }
  },
  "SkiaPipelineFeatures": {
    "EnableRawLinearPayloads": true,
    "EnableProcessedFrameEncoder": true
  },
  "FrameExport": {
    "Raw": {
      "Enabled": true,
      "PayloadScope": "ArchiveOnly",
      "ArchiveEncoding": {
        "Format": "Fits",
        "Quality": 100,
        "FitsOptions": {
          "BitDepth": "U16",
          "ImageFormat": "Mono",
          "Compression": "None",
          "UnsignedU16": true,
          "WriteChecksum": true
        }
      },
      "DeliveryEncoding": null,
      "Filesystem": [
        {
          "Enabled": true,
          "RootPath": "/workspaces/HVOv9/artifacts/skymonitor",
          "Prefix": null,
          "IncludeMetadataManifest": true
        }
      ],
      "S3": [
        {
          "Enabled": true,
          "Bucket": "hvo-skymonitor",
          "Prefix": "raw",
          "Endpoint": "http://192.168.2.104:9000",
          "AccessKey": "admin",
          "SecretKey": "change-me-now-32chars",
          "Region": "us-west-2",
          "UseSsl": false,
          "EmitMetadataHeaders": true,
          "EmitJsonManifest": true
        }
      ]
    },
    "Processed": {
      "Enabled": true,
      "PayloadScope": "ArchiveOnly",
      "ArchiveEncoding": {
        "Format": "Jpeg",
        "Quality": 95,
        "FitsOptions": null
      },
      "DeliveryEncoding": null,
      "Filesystem": [
        {
          "Enabled": true,
          "RootPath": "/workspaces/HVOv9/artifacts/skymonitor",
          "Prefix": "processed",
          "IncludeMetadataManifest": true
        }
      ],
      "S3": [
        {
          "Enabled": true,
          "Bucket": "hvo-skymonitor",
          "Prefix": "processed",
          "Endpoint": "http://192.168.2.104:9000",
          "AccessKey": "admin",
          "SecretKey": "change-me-now-32chars",
          "Region": "us-west-2",
          "UseSsl": false,
          "EmitMetadataHeaders": true,
          "EmitJsonManifest": true
        }
      ]
    }
  },
  "AllowedHosts": "*"
}