{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "HVO.SkyMonitorV5.RPi.Pipeline.FrameFilterPipeline": "Debug",
      "HVO.SkyMonitorV5.RPi.Pipeline.RollingFrameStacker": "Trace",
      "HVO.SkyMonitorV5.RPi.Pipeline.Filters.CardinalDirectionsFilter": "Trace",
      "HVO.SkyMonitorV5.RPi.Pipeline.Filters.CelestialAnnotationsFilter": "Debug",
      "HVO.SkyMonitorV5.RPi.Pipeline.Filters.ConstellationFigureFilter": "Debug",
      "HVO.SkyMonitorV5.RPi.Pipeline.Filters.CircularApertureMaskFilter": "Debug",
      "HVO.SkyMonitorV5.RPi.Cameras.MockCameraAdapter": "Debug"
    }
  },
  "SkyMonitor": {
    "Logging": {
      "Directory": "/workspaces/HVOv9/logs"
    },
    "Data": {
      "OverrideRootPath": "/workspaces/HVOv9/datastores"
    }
  },
  "CameraPipeline": {
    "Overrides": {
      "EnableStacking": true,
      "StackingFrameCount": 4,
      "StackingBufferMinimumFrames": 24,
      "StackingBufferIntegrationSeconds": 120,
      "BackgroundStackerEnabled": true,
      "EnableImageOverlays": true,
      "FrameFilters": [
        "CardinalDirections",
        "ConstellationFigures",
        "CelestialAnnotations",
        "OverlayText",
        "CircularApertureMask"
      ],
      "DisableSensorNoise": false
    },
    "CelestialAnnotations": {
      "LabelFontSize": 12.0,
      "StarRingRadius": 6.0,
      "PlanetRingRadius": 10.0,
      "DeepSkyRingRadius": 12.0,
      "StarLabelColor": "#EBF5FF",
      "PlanetLabelColor": "#FFE8C5",
      "DeepSkyLabelColor": "#F0E4FF"
    }
  },
  "FrameExport": {
    "Raw": {
      "Enabled": true,
      "Filesystem": [
        {
          "Enabled": true,
          "RootPath": "/workspaces/HVOv9/artifacts/exports",
          "Prefix": "skymonitor/raw",
          "IncludeMetadataManifest": true
        }
      ],
      "S3": [
        {
          "Enabled": true,
          "Bucket": "skymonitor",
          "Prefix": "raw",
          "Endpoint": "192.168.2.104:9000",
          "AccessKey": "admin",
          "SecretKey": "change-me-now-32chars",
          "Region": "us-west-2",
          "UseSsl": false,
          "EmitMetadataHeaders": true,
          "EmitJsonManifest": true
        }
      ]
    },
    "Processed": {
      "Enabled": true,
      "Filesystem": [
        {
          "Enabled": true,
          "RootPath": "/workspaces/HVOv9/artifacts/exports",
          "Prefix": "skymonitor/processed",
          "IncludeMetadataManifest": true
        }
      ],
      "S3": [
        {
          "Enabled": true,
          "Bucket": "skymonitor",
          "Prefix": "processed",
          "Endpoint": "192.168.2.104:9000",
          "AccessKey": "admin",
          "SecretKey": "change-me-now-32chars",
          "Region": "us-west-2",
          "UseSsl": false,
          "EmitMetadataHeaders": true,
          "EmitJsonManifest": true
        }
      ]
    }
  }
}
