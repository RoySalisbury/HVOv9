@page "/image-history"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using HVO.SkyMonitorV5.RPi.Components.Shared
@using HVO.SkyMonitorV5.RPi.Models.ImageHistory
@using HVO.SkyMonitorV5.RPi.Components.Pages.Partials

<PageTitle>SkyMonitor v5 · Image History</PageTitle>

<section class="container-fluid py-3">
    <SkyMonitorSecondaryTabs Tabs="@HistoryTabs"
                             Label="Image history navigation"
                             ActiveTabKey="@ActiveTabKey" />
</section>

<main class="container-fluid image-history-shell" data-theme="hvo-dark">
    <div class="image-history-layout">
        <ImageHistoryFilters Filters="@_filters"
                              OnFiltersApplied="HandleFiltersAppliedAsync"
                              OnRefreshRequested="HandleRefreshRequestedAsync"
                              IsBusy="@IsBusy" />

        <section class="image-history-content" aria-live="polite">
            <ImageHistoryRail Items="@_thumbnails"
                               SelectedFrameId="@_selectedFrameId"
                               OnSelectItem="HandleThumbnailSelectedAsync"
                               OnRefreshRequested="HandleRefreshRequestedAsync"
                               HasMoreItems="@(!string.IsNullOrEmpty(_nextCursor))"
                               OnLoadMoreRequested="LoadMoreThumbnailsAsync"
                               OnNavigate="HandleRailNavigateAsync"
                               IsLoading="@_isLoadingThumbnails"
                               ErrorMessage="@_thumbnailError" />

            <ImageHistoryDetail Detail="@_selectedDetail"
                                Charts="@_chartSeries"
                                IsLoading="@_isLoadingDetail"
                                ErrorMessage="@_detailError" />
        </section>
    </div>
</main>
