@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

<PageTitle>SkyMonitor v5 · Dashboard</PageTitle>

<section class="container py-5 text-light">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            <h1 class="display-5 fw-semibold mb-3">SkyMonitor Dashboard (WIP)</h1>
            <p class="lead text-muted">
                This dashboard is being rebuilt. Use the monitor view to access live imagery and telemetry while the new
                overview is designed.
            </p>
            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                <NavLink class="btn btn-sm btn-primary" href="/monitor">
                    <i class="bi bi-broadcast-pin me-2"></i>
                    Open Monitor
                </NavLink>
                <NavLink class="btn btn-sm btn-outline-light" href="/diagnostics">
                    <i class="bi bi-speedometer2 me-2"></i>
                    View Diagnostics
                </NavLink>
            </div>
        </div>
    </div>
</section>
