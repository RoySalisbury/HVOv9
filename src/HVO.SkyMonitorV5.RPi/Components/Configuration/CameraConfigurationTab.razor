@using HVO.SkyMonitorV5.RPi.Models.Cameras
@using HVO.SkyMonitorV5.RPi.Models.Rigs
@using HVO.SkyMonitorV5.RPi.Cameras.Optics

<div class="container py-4 text-light">
    <header class="config-toolbar">
        <div class="config-toolbar__info">
            <h1 class="config-toolbar__title">Camera Configuration</h1>
            <p class="config-toolbar__subtitle">Manage camera catalog entries and inspect telemetry metadata.</p>
        </div>
        <div class="config-toolbar__actions">
            <button type="button"
                    class="btn btn-sm btn-outline-info"
                    @onclick="ReloadAsync"
                    disabled="@(!CanReloadCatalog)">
                <i class="bi bi-arrow-clockwise me-2" aria-hidden="true"></i>
                Refresh
            </button>
        </div>
        <div class="config-toolbar__status @GetToolbarStatusCss()">
            @if (IsBusy)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            @GetToolbarStatus()
        </div>
    </header>

    <div class="row g-4">
        <div class="col-12">
            <section class="card bg-dark border-secondary shadow-sm config-card">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h2 class="h5 mb-1 config-card__title">Camera Catalog</h2>
                        <p class="mb-0 text-muted small">Create and maintain camera profiles available to rigs and adapters.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                        <div class="input-group input-group-sm camera-filter">
                            <span class="input-group-text bg-transparent border-secondary text-muted">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search"
                                   class="form-control"
                                   placeholder="Filter cameras…"
                                   @bind="SearchText"
                                   @bind:event="oninput"
                                   aria-label="Filter cameras by name, identifier, or driver" />
                        </div>
                        <button type="button"
                                class="btn btn-outline-light btn-sm config-card__collapse"
                                @onclick="ToggleCatalogSection"
                                aria-expanded="@(!_catalogCollapsed)"
                                aria-controls="camera-catalog"
                                title='@GetCollapseButtonTitle("Camera catalog", _catalogCollapsed)'>
                            <i class="@GetCollapseIconCss(_catalogCollapsed)" aria-hidden="true"></i>
                            <span class="visually-hidden">@GetCollapseButtonTitle("Camera catalog", _catalogCollapsed)</span>
                        </button>
                    </div>
                </div>
                <div id="camera-catalog"
                     class="card-body @GetCollapseCss(_catalogCollapsed)"
                     aria-hidden="@_catalogCollapsed">
                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="alert alert-danger mb-0" role="alert">
                            @_errorMessage
                        </div>
                    }
                    else if (_isLoading && FilteredCameras.Count == 0)
                    {
                        <div class="d-flex align-items-center gap-3 text-muted py-2">
                            <div class="spinner-border text-secondary" role="status">
                                <span class="visually-hidden">Loading camera catalog…</span>
                            </div>
                            <span>Loading camera catalog…</span>
                        </div>
                    }
                    else if (FilteredCameras.Count == 0)
                    {
                        <p class="text-muted mb-0">@GetEmptyFilterMessage()</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-striped align-middle camera-table mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Camera</th>
                                        <th scope="col">Key</th>
                                        <th scope="col">Manufacturer</th>
                                        <th scope="col">Model</th>
                                        <th scope="col" class="text-center">Sensor (px)</th>
                                        <th scope="col">Lifecycle</th>
                                        <th scope="col">Assigned Rigs</th>
                                        <th scope="col" class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var camera in FilteredCameras)
                                    {
                                        var usage = GetCameraUsage(camera.Key);
                                        var isSelected = _selectedCameraId == camera.Id;
                                        <tr class="@(isSelected ? "table-active" : string.Empty)" @onclick="() => HandleRowSelection(camera)">
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span>@camera.DisplayName</span>
                                                    <small class="text-muted">@camera.DriverVersion</small>
                                                </div>
                                            </td>
                                            <td><code>@camera.Key</code></td>
                                            <td>@camera.Manufacturer</td>
                                            <td>@camera.Model</td>
                                            <td class="text-center">@FormatResolution(camera)</td>
                                            <td>
                                                <div class="d-flex flex-column gap-1" title="@GetLifecycleTitle(camera)">
                                                    <span class="@GetStatusBadgeCss(camera.IsActive)">@GetStatusLabel(camera.IsActive)</span>
                                                    <span class="text-muted small">@FormatLifecycleLabel(camera.UpdatedUtc)</span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column gap-1">
                                                    <span class="@GetUsageBadgeCss(camera.IsInUse)">@GetUsageBadgeText(usage.Count)</span>
                                                    <span class="text-muted small">@GetCameraUsageSummary(camera.Key)</span>
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group" role="group" aria-label="Camera actions">
                                                    <button type="button"
                                                            class="btn btn-outline-light btn-sm"
                                                            title="Edit camera"
                                                            @onclick="(() => SelectCamera(camera))"
                                                            @onclick:stopPropagation="true"
                                                            disabled="@_isSaving">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_lastUpdatedMessage) && !_isLoading)
                {
                    <div class="card-footer border-secondary text-end text-muted small">
                        @_lastUpdatedMessage
                    </div>
                }
            </section>
        </div>

        <div class="col-12">
            <section class="card bg-dark border-secondary shadow-sm config-card">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h2 class="h5 mb-1 config-card__title">Telemetry &amp; Audit</h2>
                        <p class="mb-0 text-muted small">Inspect lifecycle metadata and capabilities for the selected camera.</p>
                    </div>
                    <button type="button"
                            class="btn btn-outline-light btn-sm config-card__collapse"
                            @onclick="ToggleTelemetrySection"
                            aria-expanded="@(!_telemetryCollapsed)"
                            aria-controls="camera-telemetry"
                            title='@GetCollapseButtonTitle("Camera telemetry", _telemetryCollapsed)'>
                        <i class="@GetCollapseIconCss(_telemetryCollapsed)" aria-hidden="true"></i>
                        <span class="visually-hidden">@GetCollapseButtonTitle("Camera telemetry", _telemetryCollapsed)</span>
                    </button>
                </div>
                <div id="camera-telemetry"
                     class="card-body @GetCollapseCss(_telemetryCollapsed)"
                     aria-hidden="@_telemetryCollapsed">
                    @if (SelectedCamera is null)
                    {
                        <p class="text-muted mb-0">Select a camera from the catalog to review telemetry and audit information.</p>
                    }
                    else
                    {
                        var driverDescriptor = ResolveDriverDescriptor(SelectedCamera.DriverId);
                        var rigs = GetCameraUsage(SelectedCamera.Key);
                        var capabilities = GetCapabilityLabels(SelectedCamera);
                        var tags = GetAdditionalTags(SelectedCamera);
                        var coolingTarget = GetCoolingTargetLabel(SelectedCamera);

                        <div class="row g-4">
                            <div class="col-lg-6">
                                <dl class="row audit-list">
                                    <dt class="col-sm-4 text-muted">Camera Key</dt>
                                    <dd class="col-sm-8"><code>@SelectedCamera.Key</code></dd>

                                    <dt class="col-sm-4 text-muted">Driver</dt>
                                    <dd class="col-sm-8">
                                        @if (driverDescriptor is not null)
                                        {
                                            <div>@driverDescriptor.DisplayName</div>
                                            @if (!string.IsNullOrWhiteSpace(driverDescriptor.Description))
                                            {
                                                <div class="text-muted small">@driverDescriptor.Description</div>
                                            }
                                            else
                                            {
                                                <div class="text-muted small">No driver description.</div>
                                            }
                                            <code class="d-block mt-1">@SelectedCamera.DriverId</code>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(SelectedCamera.DriverId))
                                        {
                                            <code>@SelectedCamera.DriverId</code>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not assigned</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-4 text-muted">Driver Version</dt>
                                    <dd class="col-sm-8 text-muted">@(!string.IsNullOrWhiteSpace(SelectedCamera.DriverVersion) ? SelectedCamera.DriverVersion : "Not specified")</dd>

                                    <dt class="col-sm-4 text-muted">Adapter</dt>
                                    <dd class="col-sm-8 text-muted">@(!string.IsNullOrWhiteSpace(SelectedCamera.AdapterName) ? SelectedCamera.AdapterName : "Not specified")</dd>

                                    <dt class="col-sm-4 text-muted">Lifecycle</dt>
                                    <dd class="col-sm-8 text-muted">@GetLifecycleSummary(SelectedCamera)</dd>

                                    <dt class="col-sm-4 text-muted">Created</dt>
                                    <dd class="col-sm-8 text-muted">@FormatAuditTimestamp(SelectedCamera.CreatedUtc)</dd>

                                    <dt class="col-sm-4 text-muted">Updated</dt>
                                    <dd class="col-sm-8 text-muted">@FormatAuditTimestamp(SelectedCamera.UpdatedUtc)</dd>
                                </dl>
                            </div>
                            <div class="col-lg-6">
                                <dl class="row audit-list">
                                    <dt class="col-sm-4 text-muted">Sensor</dt>
                                    <dd class="col-sm-8 text-muted">@GetSensorSummary(SelectedCamera)</dd>

                                    <dt class="col-sm-4 text-muted">Color</dt>
                                    <dd class="col-sm-8 text-muted">@GetColorSummary(SelectedCamera)</dd>

                                    <dt class="col-sm-4 text-muted">Cooling</dt>
                                    <dd class="col-sm-8 text-muted">
                                        @GetCoolingSummary(SelectedCamera)
                                        @if (coolingTarget is not null)
                                        {
                                            <span class="text-muted ms-2">(@coolingTarget)</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-4 text-muted">Capabilities</dt>
                                    <dd class="col-sm-8">
                                        @if (capabilities.Count == 0)
                                        {
                                            <span class="text-muted">No capabilities documented.</span>
                                        }
                                        else
                                        {
                                            <div class="audit-badges">
                                                @foreach (var capability in capabilities)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis audit-badge">@capability</span>
                                                }
                                            </div>
                                        }
                                    </dd>

                                    <dt class="col-sm-4 text-muted">Additional Tags</dt>
                                    <dd class="col-sm-8">
                                        @if (tags.Count == 0)
                                        {
                                            <span class="text-muted">No additional tags.</span>
                                        }
                                        else
                                        {
                                            <div class="audit-badges">
                                                @foreach (var tag in tags)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis audit-badge">@tag</span>
                                                }
                                            </div>
                                        }
                                    </dd>

                                    <dt class="col-sm-4 text-muted">Assigned Rigs</dt>
                                    <dd class="col-sm-8 text-muted">
                                        @if (rigs.Count == 0)
                                        {
                                            <span class="text-muted">Not assigned to any rig.</span>
                                        }
                                        else
                                        {
                                            <ul class="audit-rig-list mb-0">
                                                @foreach (var rig in rigs)
                                                {
                                                    <li>
                                                        <i class="bi bi-diagram-3 me-2" aria-hidden="true"></i>
                                                        @rig.DisplayName
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-12">
            <section class="card bg-dark border-secondary shadow-sm config-card">
                <div class="card-header border-secondary d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h2 class="h5 mb-1 d-flex align-items-center gap-2 config-card__title">Configure Camera
                            <span class="label-tooltip" role="img" aria-label="Adjust camera metadata, capabilities, and lifecycle state." title="Adjust camera metadata, capabilities, and lifecycle state.">
                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                            </span>
                        </h2>
                        <p class="mb-0 text-muted small">Update catalog details so rigs and adapters can reference accurate sensor data.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @if (_editModel is not null)
                        {
                            <span class="badge bg-secondary-subtle text-secondary-emphasis">@(_editModel.Id > 0 ? $"ID {_editModel.Id} · Rev {_editModel.Revision}" : "New Camera Draft")</span>
                        }
                        <button type="button"
                                class="btn btn-outline-light btn-sm config-card__collapse"
                                @onclick="ToggleEditorSection"
                                aria-expanded="@(!_editorCollapsed)"
                                aria-controls="camera-editor"
                                title='@GetCollapseButtonTitle("Camera editor", _editorCollapsed)'>
                            <i class="@GetCollapseIconCss(_editorCollapsed)" aria-hidden="true"></i>
                            <span class="visually-hidden">@GetCollapseButtonTitle("Camera editor", _editorCollapsed)</span>
                        </button>
                    </div>
                </div>
                <div id="camera-editor"
                     class="card-body @GetCollapseCss(_editorCollapsed)"
                     aria-hidden="@_editorCollapsed">
                    @if (!string.IsNullOrWhiteSpace(_successMessage))
                    {
                        <div class="alert alert-success" role="status">
                            @_successMessage
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_errorMessage) && !_isLoading)
                    {
                        <div class="alert alert-danger" role="alert">
                            @_errorMessage
                        </div>
                    }

                    @if (_editContext is null || _editModel is null)
                    {
                        <p class="text-muted mb-0">Select a camera from the catalog to begin editing.</p>
                    }
                    else
                    {
                        <EditForm EditContext="@_editContext">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />

                            <div class="row g-3">
                                <div class="col-md-6 col-xl-4">
                                    <label for="camera-display" class="form-label config-label">
                                        Display Name
                                        <span class="label-tooltip" role="img" aria-label="Display name shown in dashboards and logs." title="Display name shown in dashboards and logs.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputText id="camera-display" class="form-control" @bind-Value="_editModel.DisplayName" />
                                </div>
                                <div class="col-md-6 col-xl-4">
                                    <label for="camera-key" class="form-label config-label">
                                        Camera Key
                                        <span class="label-tooltip" role="img" aria-label="Immutable identifier referenced by rigs." title="Immutable identifier referenced by rigs.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    @if (_editModel.Id == 0)
                                    {
                                        <InputText id="camera-key" class="form-control" @bind-Value="_editModel.Key" autocomplete="off" inputmode="text" pattern="^[A-Za-z0-9_-]+$" />
                                        <div class="form-text">Letters, numbers, hyphen, and underscore only.</div>
                                    }
                                    else
                                    {
                                        <InputText id="camera-key" class="form-control" @bind-Value="_editModel.Key" readonly />
                                    }
                                </div>
                                <div class="col-md-6 col-xl-4">
                                    <label for="camera-manufacturer" class="form-label config-label">
                                        Manufacturer
                                        <span class="label-tooltip" role="img" aria-label="Manufacturer name reported for the camera body." title="Manufacturer name reported for the camera body.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputText id="camera-manufacturer" class="form-control" @bind-Value="_editModel.Manufacturer" />
                                </div>
                                <div class="col-md-6 col-xl-4">
                                    <label for="camera-model" class="form-label config-label">
                                        Model
                                        <span class="label-tooltip" role="img" aria-label="Model identifier used in UI displays." title="Model identifier used in UI displays.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputText id="camera-model" class="form-control" @bind-Value="_editModel.Model" />
                                </div>
                                <div class="col-md-6 col-xl-4">
                                    <label for="camera-driver-version" class="form-label config-label">
                                        Driver Version
                                        <span class="label-tooltip" role="img" aria-label="Driver or SDK version paired with this camera." title="Driver or SDK version paired with this camera.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputText id="camera-driver-version" class="form-control" @bind-Value="_editModel.DriverVersion" />
                                </div>
                                <div class="col-md-6 col-xl-4">
                                    <label for="camera-adapter" class="form-label config-label">
                                        Adapter Name
                                        <span class="label-tooltip" role="img" aria-label="Adapter class or integration responsible for this camera." title="Adapter class or integration responsible for this camera.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputText id="camera-adapter" class="form-control" @bind-Value="_editModel.AdapterName" />
                                </div>
                                <div class="col-md-6 col-xl-4">
                                    <label for="camera-driver-id" class="form-label config-label">
                                        Driver Identifier
                                        <span class="label-tooltip" role="img" aria-label="Driver identifier used when connecting to hardware." title="Driver identifier used when connecting to hardware.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    @if (_driverDescriptors.Count == 0)
                                    {
                                        <InputText id="camera-driver-id" class="form-control" @bind-Value="_editModel.DriverId" />
                                        <div class="form-text">Driver registry is unavailable; enter the identifier manually.</div>
                                    }
                                    else
                                    {
                                        <InputSelect id="camera-driver-id" class="form-select" @bind-Value="_editModel.DriverId">
                                            <option value="">Select a driver…</option>
                                            @foreach (var driver in _driverDescriptors)
                                            {
                                                <option value="@driver.Id">@driver.DisplayName (@driver.Id)</option>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(_editModel.DriverId) && ResolveDriverDescriptor(_editModel.DriverId) is null)
                                            {
                                                <option value="@_editModel.DriverId">@_editModel.DriverId (custom)</option>
                                            }
                                        </InputSelect>
                                        <div class="form-text">
                                            @if (ResolveDriverDescriptor(_editModel.DriverId) is { } descriptor)
                                            {
                                                <span>@descriptor.Description</span>
                                            }
                                            else
                                            {
                                                <span>Choose a registered driver or enter a custom identifier.</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="col-12">
                                    <label for="camera-driver-settings" class="form-label config-label">
                                        Driver Settings JSON
                                        <span class="label-tooltip" role="img" aria-label="Optional driver-specific configuration payload." title="Optional driver-specific configuration payload.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputTextArea id="camera-driver-settings"
                                                   class="form-control font-monospace"
                                                   @bind-Value="_editModel.DriverSettingsJson"
                                                   rows="6"
                                                   placeholder="{ &quot;gainMode&quot;: &quot;High&quot; }" />
                                    <div class="form-text">@GetDriverSettingsHelpText()</div>
                                </div>
                                <div class="col-md-6 col-xl-4">
                                    <label for="camera-synthetic-profile" class="form-label config-label">
                                        Synthetic Profile
                                        <span class="label-tooltip" role="img" aria-label="Synthetic camera profile to load when emulating hardware." title="Synthetic camera profile to load when emulating hardware.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputText id="camera-synthetic-profile" class="form-control" @bind-Value="_editModel.SyntheticProfile" disabled="@(!_editModel.IsSynthetic)" />
                                </div>
                                <div class="col-md-6 col-xl-4 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <InputCheckbox id="camera-synthetic" class="form-check-input" @bind-Value="_editModel.IsSynthetic" />
                                        <label for="camera-synthetic" class="form-check-label text-light">
                                            Synthetic Camera
                                            <span class="label-tooltip" role="img" aria-label="Toggle for virtual cameras that do not correspond to physical hardware." title="Toggle for virtual cameras that do not correspond to physical hardware.">
                                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label for="camera-width" class="form-label config-label">
                                        Sensor Width (px)
                                        <span class="label-tooltip" role="img" aria-label="Full sensor width in pixels." title="Full sensor width in pixels.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputNumber TValue="int" id="camera-width" class="form-control" @bind-Value="_editModel.SensorWidthPixels" min="1" />
                                </div>
                                <div class="col-md-4">
                                    <label for="camera-height" class="form-label config-label">
                                        Sensor Height (px)
                                        <span class="label-tooltip" role="img" aria-label="Full sensor height in pixels." title="Full sensor height in pixels.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputNumber TValue="int" id="camera-height" class="form-control" @bind-Value="_editModel.SensorHeightPixels" min="1" />
                                </div>
                                <div class="col-md-4">
                                    <label for="camera-pixel" class="form-label config-label">
                                        Pixel Size (µm)
                                        <span class="label-tooltip" role="img" aria-label="Physical pixel size in microns." title="Physical pixel size in microns.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputNumber TValue="double" id="camera-pixel" class="form-control" @bind-Value="_editModel.PixelSizeMicrons" step="0.01" min="0.01" />
                                </div>
                                <div class="col-md-4">
                                    <label for="camera-cx" class="form-label config-label">
                                        Sensor Cx (px)
                                        <span class="label-tooltip" role="img" aria-label="Principal point X coordinate (optional)." title="Principal point X coordinate (optional).">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputNumber TValue="double?" id="camera-cx" class="form-control" @bind-Value="_editModel.SensorCxPixels" step="0.1" min="0" />
                                </div>
                                <div class="col-md-4">
                                    <label for="camera-cy" class="form-label config-label">
                                        Sensor Cy (px)
                                        <span class="label-tooltip" role="img" aria-label="Principal point Y coordinate (optional)." title="Principal point Y coordinate (optional).">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputNumber TValue="double?" id="camera-cy" class="form-control" @bind-Value="_editModel.SensorCyPixels" step="0.1" min="0" />
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <InputCheckbox id="camera-color" class="form-check-input" @bind-Value="_editModel.IsColor" />
                                        <label for="camera-color" class="form-check-label text-light">
                                            Color Sensor
                                            <span class="label-tooltip" role="img" aria-label="Turn on for Bayer/OSC sensors; leave off for monochrome sensors." title="Turn on for Bayer/OSC sensors; leave off for monochrome sensors.">
                                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label for="camera-tech" class="form-label config-label">
                                        Sensor Technology
                                        <span class="label-tooltip" role="img" aria-label="Underlying sensor silicon technology." title="Underlying sensor silicon technology.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputSelect id="camera-tech" class="form-select" @bind-Value="_editModel.SensorTechnology" TValue="CameraSensorTechnology">
                                        <option value="@CameraSensorTechnology.Cmos">CMOS</option>
                                        <option value="@CameraSensorTechnology.Ccd">CCD</option>
                                    </InputSelect>
                                </div>
                                <div class="col-md-4">
                                    <label for="camera-body" class="form-label config-label">
                                        Body Type
                                        <span class="label-tooltip" role="img" aria-label="Body classification such as dedicated astronomy or DSLR." title="Body classification such as dedicated astronomy or DSLR.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputText id="camera-body" class="form-control" @bind-Value="_editModel.BodyType" />
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <InputCheckbox id="camera-cooling-enabled" class="form-check-input" @bind-Value="_editModel.HasCooling" />
                                        <label for="camera-cooling-enabled" class="form-check-label text-light">
                                            Regulated Cooling
                                            <span class="label-tooltip" role="img" aria-label="Enable when the camera includes regulated cooling hardware." title="Enable when the camera includes regulated cooling hardware.">
                                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label for="camera-cooling-target" class="form-label config-label">
                                        Cooling Target (°C)
                                        <span class="label-tooltip" role="img" aria-label="Optional regulated cooling target temperature in Celsius." title="Optional regulated cooling target temperature in Celsius.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputNumber TValue="double?" id="camera-cooling-target" class="form-control" @bind-Value="_editModel.CoolingTargetCelsius" step="0.5" min="-80" max="40" disabled="@(!_editModel.HasCooling)" />
                                    <div class="form-text">Leave blank to use the camera default.</div>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <InputCheckbox id="camera-gain" class="form-check-input" @bind-Value="_editModel.SupportsGainControl" />
                                        <label for="camera-gain" class="form-check-label text-light">
                                            Gain Control
                                            <span class="label-tooltip" role="img" aria-label="Indicates whether gain can be adjusted through software." title="Indicates whether gain can be adjusted through software.">
                                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <InputCheckbox id="camera-exposure" class="form-check-input" @bind-Value="_editModel.SupportsExposureControl" />
                                        <label for="camera-exposure" class="form-check-label text-light">
                                            Exposure Control
                                            <span class="label-tooltip" role="img" aria-label="Toggle when exposure duration can be commanded via software." title="Toggle when exposure duration can be commanded via software.">
                                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <InputCheckbox id="camera-telemetry" class="form-check-input" @bind-Value="_editModel.SupportsTemperatureTelemetry" />
                                        <label for="camera-telemetry" class="form-check-label text-light">
                                            Temperature Telemetry
                                            <span class="label-tooltip" role="img" aria-label="Enable when the camera exposes internal temperature telemetry." title="Enable when the camera exposes internal temperature telemetry.">
                                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <InputCheckbox id="camera-binning" class="form-check-input" @bind-Value="_editModel.SupportsSoftwareBinning" />
                                        <label for="camera-binning" class="form-check-label text-light">
                                            Software Binning
                                            <span class="label-tooltip" role="img" aria-label="Enable to allow 2×2 or higher software binning modes." title="Enable to allow 2×2 or higher software binning modes.">
                                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <InputCheckbox id="camera-active" class="form-check-input" @bind-Value="_editModel.IsActive" />
                                        <label for="camera-active" class="form-check-label text-light">
                                            Active in catalog
                                            <span class="label-tooltip" role="img" aria-label="Inactive entries remain in the catalog but are hidden from assignment pickers." title="Inactive entries remain in the catalog but are hidden from assignment pickers.">
                                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label for="camera-tags" class="form-label config-label">
                                        <span>Additional Tags</span>
                                        <span class="label-tooltip" role="img" aria-label="Additional capability tags (one per line or comma separated)." title="Additional capability tags (one per line or comma separated).">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputTextArea id="camera-tags" class="form-control" rows="2" @bind-Value="_editModel.AdditionalTagsInput" placeholder="Enter tags separated by commas or new lines." />
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-4">
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@(!CanSave)" title="Save changes to the camera catalog.">
                                    <i class="bi bi-save me-2"></i>
                                    Save Changes
                                </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetChanges" disabled="@(!_hasChanges || _isSaving)" title="Discard changes and revert to the saved values.">
                                    <i class="bi bi-arrow-counterclockwise me-2"></i>
                                    Reset
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </section>
        </div>
    </div>
</div>
