@using HVO.SkyMonitorV5.RPi.Models.Adapters
@using HVO.SkyMonitorV5.RPi.Models.Rigs
@using Microsoft.AspNetCore.Components.Forms

<div class="container py-4 text-light">
    <div class="row g-4">
        <div class="col-12">
            <section class="card bg-dark border-secondary shadow-sm config-card">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h2 class="h5 mb-1 d-flex align-items-center gap-2 config-card__title">Camera Adapters
                            <span class="label-tooltip" role="img" aria-label="Manage adapter instances that bind rigs to capture drivers." title="Manage adapter instances that bind rigs to capture drivers.">
                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                            </span>
                        </h2>
                        <p class="mb-0 text-muted small">Each adapter maps a rig to a specific camera driver implementation.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                title="Create a new camera adapter"
                                @onclick="BeginCreate"
                                disabled="@(!_hasRigOptions || _isLoading || _isSaving)">
                            <i class="bi bi-plus-circle me-2"></i>
                            New Adapter
                        </button>
                        <button type="button"
                                class="btn btn-outline-light btn-sm"
                                title="Refresh adapter catalog"
                                @onclick="ReloadAsync"
                                disabled="@(_isLoading || _isSaving)">
                            <i class="bi bi-arrow-clockwise me-2"></i>
                            Refresh
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (_isLoading)
                    {
                        <div class="d-flex align-items-center gap-3 text-muted py-2">
                            <div class="spinner-border text-secondary" role="status">
                                <span class="visually-hidden">Loading adapter catalog…</span>
                            </div>
                            <span>Loading adapter catalog…</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="alert alert-danger mb-0" role="alert">
                            @_errorMessage
                        </div>
                    }
                    else if (_adapters.Count == 0)
                    {
                        <p class="text-muted mb-0">No adapters are configured. Create an adapter to bind a rig to a capture driver.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Adapter</th>
                                        <th scope="col">Type</th>
                                        <th scope="col">Rig Binding</th>
                                        <th scope="col" class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var adapter in _adapters)
                                    {
                                        var isSelected = _editModel?.Id == adapter.Id && adapter.Id != 0;
                                        <tr class="@(isSelected ? "table-active" : string.Empty)" @onclick="() => HandleRowSelection(adapter)">
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span>@adapter.Name</span>
                                                    @if (adapter.RigRevision > 0)
                                                    {
                                                        <small class="text-muted">Rig Revision @adapter.RigRevision</small>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span>@GetAdapterTypeLabel(adapter.AdapterType)</span>
                                                    <small class="text-muted">@adapter.AdapterType</small>
                                                </div>
                                            </td>
                                            <td>
                                                @if (string.IsNullOrWhiteSpace(adapter.RigDisplayName))
                                                {
                                                    <span class="badge bg-danger-subtle text-danger-emphasis">Rig Missing</span>
                                                }
                                                else
                                                {
                                                    <div class="d-flex flex-column">
                                                        <span>@adapter.RigDisplayName</span>
                                                        <small class="text-muted">@adapter.RigKey</small>
                                                    </div>
                                                    @if (adapter.RigIsActive)
                                                    {
                                                        <span class="badge bg-success-subtle text-success-emphasis mt-1">Active Rig</span>
                                                    }
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group" role="group" aria-label="Adapter actions">
                                                    <button type="button"
                                                            class="btn btn-outline-light btn-sm"
                                                            title="Edit adapter"
                                                            @onclick="(() => SelectAdapter(adapter))"
                                                            @onclick:stopPropagation="true"
                                                            disabled="@_isSaving">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-outline-danger btn-sm"
                                                            title="Delete adapter"
                                                            @onclick="(() => ConfirmDeleteAdapterAsync(adapter))"
                                                            @onclick:stopPropagation="true"
                                                            disabled="@(_isSaving)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                @if (_hasRigOptions is false)
                {
                    <div class="card-footer border-secondary text-warning small">
                        Create a rig before adding adapters. Adapters cannot be configured without at least one rig entry.
                    </div>
                }
            </section>
        </div>

        <div class="col-12">
            <section class="card bg-dark border-secondary shadow-sm config-card">
                <div class="card-header border-secondary d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h2 class="h5 mb-1 d-flex align-items-center gap-2 config-card__title">Configure Adapter
                            <span class="label-tooltip" role="img" aria-label="Assign a rig to a capture adapter driver." title="Assign a rig to a capture adapter driver.">
                                <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                            </span>
                        </h2>
                        <p class="mb-0 text-muted small">Select the capture driver and rig pairing used by the runtime camera host.</p>
                    </div>
                    @if (_editModel is not null)
                    {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis mt-1">@(_editModel.Id > 0 ? $"ID {_editModel.Id}" : "New Adapter Draft")</span>
                    }
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(_successMessage))
                    {
                        <div class="alert alert-success" role="status">
                            @_successMessage
                        </div>
                    }

                    @if (_editContext is null || _editModel is null)
                    {
                        <p class="text-muted mb-0">Select an adapter to edit or choose <strong>New Adapter</strong> to create one.</p>
                    }
                    else if (!_hasRigOptions)
                    {
                        <p class="text-warning mb-0">Create a rig before saving adapter changes.</p>
                    }
                    else
                    {
                        <EditForm EditContext="@_editContext">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label for="adapter-name" class="form-label config-label">Adapter Name
                                        <span class="label-tooltip" role="img" aria-label="Identifier referenced by services and logs." title="Identifier referenced by services and logs.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputText id="adapter-name"
                                               class="form-control"
                                               @bind-Value="_editModel.Name"
                                               autocomplete="off"
                                               inputmode="text"
                                               pattern="^[A-Za-z0-9_-]+$" />
                                    <div class="form-text">Letters, numbers, hyphen, and underscore only.</div>
                                </div>
                                <div class="col-md-4">
                                    <label for="adapter-type" class="form-label config-label">Adapter Type
                                        <span class="label-tooltip" role="img" aria-label="Select the driver that powers this adapter." title="Select the driver that powers this adapter.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputSelect id="adapter-type" class="form-select" @bind-Value="_editModel.AdapterType">
                                        @foreach (var option in AdapterTypeOptions)
                                        {
                                            <option value="@option.Value">@option.Label</option>
                                        }
                                    </InputSelect>
                                    <div class="form-text">@GetAdapterTypeDescription(_editModel.AdapterType)</div>
                                </div>
                                <div class="col-md-4">
                                    <label for="adapter-rig" class="form-label config-label">Rig Binding
                                        <span class="label-tooltip" role="img" aria-label="Choose the rig catalog entry this adapter will control." title="Choose the rig catalog entry this adapter will control.">
                                            <i class="bi bi-question-circle-fill" aria-hidden="true"></i>
                                        </span>
                                    </label>
                                    <InputSelect id="adapter-rig" class="form-select" @bind-Value="_editModel.RigKey">
                                        @foreach (var rig in _rigs)
                                        {
                                            <option value="@rig.Key">@rig.DisplayName (@rig.Key)</option>
                                        }
                                    </InputSelect>
                                    <div class="form-text">Active rig badges show which configuration currently drives the capture pipeline.</div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-4">
                                <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(!CanSave)">
                                    <i class="bi bi-save me-2"></i>
                                    Save Changes
                                </button>
                                <button type="button" class="btn btn-outline-light" @onclick="BeginCreate" disabled="@(!_hasRigOptions || _isLoading || _isSaving)">
                                    <i class="bi bi-plus-circle me-2"></i>
                                    New
                                </button>
                                <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync" disabled="@(!CanDelete)">
                                    <i class="bi bi-trash me-2"></i>
                                    Delete
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </section>
        </div>
    </div>
</div>
