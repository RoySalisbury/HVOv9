  "FrameExport": {
    "Raw": {
      "Enabled": false,
      "Filesystem": [
        {
          "Enabled": false,
          "RootPath": null,
          "Prefix": null,
          "IncludeMetadataManifest": true
        }
      ],
      "S3": [
        {
          "Enabled": false,
          "Bucket": null,
          "Prefix": null,
          "Endpoint": null,
          "AccessKey": null,
          "SecretKey": null,
          "Region": "us-west-2",
          "UseSsl": true,
          "EmitMetadataHeaders": true,
          "EmitJsonManifest": true
        }
      ]
    },
    "Processed": {
      "Enabled": false,
      "Filesystem": [
        {
          "Enabled": true,
          "RootPath": null,
          "Prefix": "processed",
          "IncludeMetadataManifest": true
        }
      ],
      "S3": [
        {
          "Enabled": false,
          "Bucket": null,
          "Prefix": null,
          "Endpoint": null,
          "AccessKey": null,
          "SecretKey": null,
          "Region": "us-west-2",
          "UseSsl": true,
          "EmitMetadataHeaders": true,
          "EmitJsonManifest": true
        }
      ]
    }
  },
  "AllowedHosts": "*"
}
