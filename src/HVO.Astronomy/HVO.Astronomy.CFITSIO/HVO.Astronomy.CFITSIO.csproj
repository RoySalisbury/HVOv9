<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>    

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>HVO.Astronomy.CFITSIO</RootNamespace>
    <AssemblyName>HVO.Astronomy.CFITSIO</AssemblyName>
    <PackageId>HVO.Astronomy.CFITSIO</PackageId>
  <Version>1.0.3</Version>
    <Authors>HVO</Authors>
    <Description>CFITSIO native binaries for P/Invoke (macOS/Linux/Windows, multi-RID).</Description>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Astronomy,FITS</PackageTags>
    <RepositoryUrl>https://github.com/RoySalisbury/HVOv9</RepositoryUrl>
    <PackageProjectUrl>https://github.com/RoySalisbury/HVOv9/HVO.Astronomy.CFITSIO</PackageProjectUrl>    
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>HAS_SKIA</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <!-- Bring in platform native assets for Skia so libSkiaSharp is copied to runtimes/*/native -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp.NativeAssets.macOS">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp.NativeAssets.Win32">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the NativeAssets package to ensure native CFITSIO binaries flow transitively to consumers -->
    <ProjectReference Include="../HVO.Astronomy.CFITSIO.NativeAssets/HVO.Astronomy.CFITSIO.NativeAssets.csproj">
      <!-- Don't mark as PrivateAssets - we want this to flow to consumers -->
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Use HVO at compile time but do not add a NuGet dependency when packing -->
    <ProjectReference Include="../../HVO/HVO.csproj" PrivateAssets="All" />
  </ItemGroup>

  <!-- Pack documentation files into the nupkg -->
  <!-- NOTE: Native assets are now provided by HVO.Astronomy.CFITSIO.NativeAssets package -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="BUILD-FEATURES.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="CopyPackageToLocalFeed" AfterTargets="Pack">
    <PropertyGroup>
      <!-- The correct path for the nupkg file after 'dotnet pack' -->
      <NupkgFileName>$(PackageId).$(PackageVersion).nupkg</NupkgFileName>
      <FullPackagePath>$(OutputPath)../$(NupkgFileName)</FullPackagePath>
      <!-- Repository root: three levels up from this project directory -->
      <LocalPackagesDir>$(MSBuildThisFileDirectory)../../../.LocalPackages</LocalPackagesDir>
    </PropertyGroup>
    <MakeDir Directories="$(LocalPackagesDir)" Condition="!Exists('$(LocalPackagesDir)')" />
    <Copy SourceFiles="$(FullPackagePath)" DestinationFolder="$(LocalPackagesDir)" Condition="Exists('$(FullPackagePath)')" />
    <Message Text="Copied package from $(FullPackagePath) to $(LocalPackagesDir)" Importance="High" />
    </Target>
</Project>
