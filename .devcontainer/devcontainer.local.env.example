# Copy to devcontainer.local.env (kept out of git) to provide local copies of the secrets.
# Values are surfaced inside the dev container directly via environment variables
# so the provisioning scripts work the same in Codespaces and on your machine.

# Database connection string for HVO.WebSite.v9
HVO_SECRET__WEBSITEV9__DB_CONNECTION=

# Database connection string for HVO.WebSite.Playground
HVO_SECRET__WEBSITEPLAYGROUND__DB_CONNECTION=

# NINA API key consumed by the playground site
HVO_SECRET__WEBSITEPLAYGROUND__NINA_API_KEY=

# Azure DevOps Personal Access Token used by the playground site
HVO_SECRET__WEBSITEPLAYGROUND__AZDO_PAT=

# SSH key material for Docker contexts (provide either raw or base64, or both)
HVO_SECRET__SSH__PRIVATE_KEY=
HVO_SECRET__SSH__PRIVATE_KEY_B64=
HVO_SECRET__SSH__PUBLIC_KEY=
HVO_SECRET__SSH__PUBLIC_KEY_B64=
