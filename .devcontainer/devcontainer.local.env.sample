# Dev Container Local Environment Variables
# Copy this file to devcontainer.local.env and fill in your values.
# The .local.env file is gitignored and will be preserved during git clean.

# Example environment variables for HVOv9 development
# Uncomment and set values as needed:

# HVO_ROOF_IPAD_DEVICE_UDID=your-device-udid-here
# HVO_CUSTOM_VAR=your-value-here
# AZURE_SUBSCRIPTION_ID=your-subscription-id

# Database connection string for HVO.WebSite.v9
#HVO_SECRET__WEBSITEV9__DB_CONNECTION="Server=tcp:hvo.database.windows.net,1433;Initial Catalog=HualapaiValleyObservatory;Persist Security Info=False;User ID=roys;Password=1qaz!qaz;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"

# Database connection string for HVO.WebSite.Playground
#HVO_SECRET__WEBSITEPLAYGROUND__DB_CONNECTION="Server=tcp:hvo.database.windows.net,1433;Initial Catalog=HualapaiValleyObservatory;Persist Security Info=False;User ID=roys;Password=1qaz!qaz;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"

# NINA API key consumed by the playground site
#HVO_SECRET__WEBSITEPLAYGROUND__NINA_API_KEY=

# Azure DevOps Personal Access Token used by the playground site
#HVO_SECRET__WEBSITEPLAYGROUND__AZDO_PAT=

# SkyMonitor V5 frame export secrets (used by setup-user-secrets.sh)
#HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_ACCESSKEY=admin
#HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_SECRETKEY=change-me-now-32chars

# SSH key material for Docker contexts (provide either raw or base64, or both)
#HVO_SECRET__SSH__PRIVATE_KEY_%
#HVO_SECRET__SSH__PUBLIC_KEY_

#TS_AUTHKEY=tskey-auth-k77u3uBCXq11CNTRL-K88JKepZGaNJiLuAQLhEaN4qHZMyZST77
#TS_HOSTNAME=vscode-container
