{
  "name": "HVOv9",
  "image": "mcr.microsoft.com/devcontainers/dotnet:9.0",
  "runArgs": [
    "--device=/dev/net/tun",
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/devcontainer.local.env"
  ],
  "privileged": true,
  "features": {
    "ghcr.io/tailscale/codespace/tailscale": {},
    "ghcr.io/devcontainers/features/docker-from-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "dotnet.defaultSolution": "src/HVOv9.DevContainer.slnx"
      },
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.vscode-dotnet-runtime",
        "GitHub.remotehub",
        "GitHub.vscode-pull-request-github",
        "ms-vsliveshare.vsliveshare",
        "GitHub.vscode-github-actions",
        "ms-azuretools.vscode-docker",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  },
  "forwardPorts": [
    5136,
    7151
  ],
  "mounts": [
    {
      "type": "volume",
      "source": "x509stores",
      "target": "/home/vscode/.dotnet/corefx/cryptography/x509stores"
    }
  ],
  "onCreateCommand": "bash scripts/setup-dotnet-dev-cert.sh",
  "postCreateCommand": "bash scripts/post-create.sh"
}