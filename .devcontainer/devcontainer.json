{
  "name": "HVOv9",
  "image": "mcr.microsoft.com/devcontainers/dotnet:9.0",
  "runArgs": [
    "--device=/dev/net/tun"
  ],
  "privileged": true,
  "features": {
    "ghcr.io/tailscale/codespace/tailscale": {},
    "ghcr.io/devcontainers/features/docker-from-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "installTools": true,
      "version": "3.11"
    }
  },
  "containerEnv": {
    // Tailscale configuration (optional) - these can be set directly in container
    "TS_AUTHKEY": "${localEnv:TS_AUTHKEY:tskey-auth-k77u3uBCXq11CNTRL-K88JKepZGaNJiLuAQLhEaN4qHZMyZST77}",
    "TS_HOSTNAME": "${localEnv:TS_HOSTNAME:vscode-container}"
  },
  "remoteEnv": {
    // These environment variables are passed through from the host macOS environment
    // Set these in your shell profile (e.g., ~/.zshrc, ~/.bash_profile) before launching VS Code
    "HVO_SECRET__SSH__PRIVATE_KEY_B64": "${env:HVO_SECRET__SSH__PRIVATE_KEY_B64}",
    "HVO_SECRET__SSH__PUBLIC_KEY_B64": "${env:HVO_SECRET__SSH__PUBLIC_KEY_B64}",
    "HVO_SECRET__WEBSITEV9__DB_CONNECTION": "${env:HVO_SECRET__WEBSITEV9__DB_CONNECTION}",
    "HVO_SECRET__WEBSITEPLAYGROUND__DB_CONNECTION": "${env:HVO_SECRET__WEBSITEPLAYGROUND__DB_CONNECTION}",
    "HVO_SECRET__WEBSITEPLAYGROUND__NINA_API_KEY": "${env:HVO_SECRET__WEBSITEPLAYGROUND__NINA_API_KEY}",
    "HVO_SECRET__WEBSITEPLAYGROUND__AZDO_PAT": "${env:HVO_SECRET__WEBSITEPLAYGROUND__AZDO_PAT}",
    "HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_ACCESSKEY": "${env:HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_ACCESSKEY}",
    "HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_SECRETKEY": "${env:HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_SECRETKEY}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "dotnet.defaultSolution": "src/HVOv9.DevContainer.slnx"
      },
      "extensions": [
        // Container-specific extensions (require container runtime environment)
        "GitHub.remotehub",
        "ms-vsliveshare.vsliveshare",
        "ms-azuretools.vscode-azure-mcp-server"
      ]
    }
  },
  "forwardPorts": [
    5136,
    7151
  ],
  "mounts": [
    {
      "type": "volume",
      "source": "x509stores",
      "target": "/home/vscode/.dotnet/corefx/cryptography/x509stores"
    }
  ],
  "postCreateCommand": "bash scripts/post-create.sh"
}