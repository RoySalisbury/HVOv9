{
  "name": "HVOv9",
  "image": "mcr.microsoft.com/devcontainers/dotnet:9.0",
  "runArgs": [
    "--device=/dev/net/tun"
  ],
  "privileged": true,
  "features": {
    "ghcr.io/tailscale/codespace/tailscale": {},
    "ghcr.io/devcontainers/features/docker-from-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "installTools": true,
      "version": "3.11"
    }
  },
  "containerEnv": {
    // Database connections (fallback to example values if not provided)
    "HVO_SECRET__WEBSITEV9__DB_CONNECTION": "${localEnv:HVO_SECRET__WEBSITEV9__DB_CONNECTION:Server=tcp:localhost,1433;Initial Catalog=HualapaiValleyObservatory;Persist Security Info=False;User ID=sa;Password=DevPassword123!;MultipleActiveResultSets=False;Encrypt=False;TrustServerCertificate=True;Connection Timeout=30;}",
    "HVO_SECRET__WEBSITEPLAYGROUND__DB_CONNECTION": "${localEnv:HVO_SECRET__WEBSITEPLAYGROUND__DB_CONNECTION:Server=tcp:localhost,1433;Initial Catalog=HualapaiValleyObservatory;Persist Security Info=False;User ID=sa;Password=DevPassword123!;MultipleActiveResultSets=False;Encrypt=False;TrustServerCertificate=True;Connection Timeout=30;}",
    
    // API keys (empty defaults - projects should handle missing keys gracefully)
    "HVO_SECRET__WEBSITEPLAYGROUND__NINA_API_KEY": "${localEnv:HVO_SECRET__WEBSITEPLAYGROUND__NINA_API_KEY:}",
    "HVO_SECRET__WEBSITEPLAYGROUND__AZDO_PAT": "${localEnv:HVO_SECRET__WEBSITEPLAYGROUND__AZDO_PAT:}",
    
    // SkyMonitor V5 frame export (development defaults)
    "HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_ACCESSKEY": "${localEnv:HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_ACCESSKEY:admin}",
    "HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_SECRETKEY": "${localEnv:HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_SECRETKEY:change-me-now-32chars}",
    
    // SSH keys (optional - will be empty if not provided)
    "HVO_SECRET__SSH__PRIVATE_KEY_B64": "${localEnv:HVO_SECRET__SSH__PRIVATE_KEY_B64:}",
    "HVO_SECRET__SSH__PUBLIC_KEY_B64": "${localEnv:HVO_SECRET__SSH__PUBLIC_KEY_B64:}",
    
    // Tailscale configuration (optional)
    "TS_AUTHKEY": "${localEnv:TS_AUTHKEY:tskey-auth-k77u3uBCXq11CNTRL-K88JKepZGaNJiLuAQLhEaN4qHZMyZST77}",
    "TS_HOSTNAME": "${localEnv:TS_HOSTNAME:vscode-container}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "dotnet.defaultSolution": "src/HVOv9.DevContainer.slnx"
      },
      "extensions": [
        // Container-specific extensions (require container runtime environment)
        "GitHub.remotehub",
        "ms-vsliveshare.vsliveshare",
        "ms-azuretools.vscode-azure-mcp-server"
      ]
    }
  },
  "forwardPorts": [
    5136,
    7151
  ],
  "mounts": [
    {
      "type": "volume",
      "source": "x509stores",
      "target": "/home/vscode/.dotnet/corefx/cryptography/x509stores"
    }
  ],
  "postCreateCommand": "bash scripts/post-create.sh"
}