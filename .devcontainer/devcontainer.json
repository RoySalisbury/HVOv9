{
  "name": "HVOv9",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "runArgs": [
    "--device=/dev/net/tun"
  ],
  "privileged": true,
  "features": {
    "ghcr.io/tailscale/codespace/tailscale": {},
    "ghcr.io/devcontainers/features/docker-from-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    // Database connections (fallback to simple localhost values if not provided)
    // Note: Complex connection strings with special characters should be set in devcontainer.local.env
    "HVO_SECRET__WEBSITEV9__DB_CONNECTION": "${localEnv:HVO_SECRET__WEBSITEV9__DB_CONNECTION:}",
    "HVO_SECRET__WEBSITEPLAYGROUND__DB_CONNECTION": "${localEnv:HVO_SECRET__WEBSITEPLAYGROUND__DB_CONNECTION:}",
    // API keys (empty defaults - projects should handle missing keys gracefully)
    "HVO_SECRET__WEBSITEPLAYGROUND__NINA_API_KEY": "${localEnv:HVO_SECRET__WEBSITEPLAYGROUND__NINA_API_KEY:}",
    "HVO_SECRET__WEBSITEPLAYGROUND__AZDO_PAT": "${localEnv:HVO_SECRET__WEBSITEPLAYGROUND__AZDO_PAT:}",
    // SkyMonitor V5 frame export (development defaults)
    "HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_ACCESSKEY": "${localEnv:HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_ACCESSKEY:admin}",
    "HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_SECRETKEY": "${localEnv:HVO_SECRET__SKYMONITORV5__FRAMEEXPORT_RAW_S3_SECRETKEY:change-me-now-32chars}",
    // SSH keys (for local dev containers - use devcontainer.local.env file)
    // For GitHub Codespaces, these will be available as repository/user secrets
    "HVO_SECRET__SSH__PRIVATE_KEY_B64": "${localEnv:HVO_SECRET__SSH__PRIVATE_KEY_B64:}",
    "HVO_SECRET__SSH__PUBLIC_KEY_B64": "${localEnv:HVO_SECRET__SSH__PUBLIC_KEY_B64:}",
    // Tailscale configuration (optional) - set real auth key in devcontainer.local.env
    "TS_AUTHKEY": "${localEnv:TS_AUTHKEY:}",
    "TS_HOSTNAME": "${localEnv:TS_HOSTNAME:vscode-container}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        // .NET Project Configuration
        "dotnet.defaultSolution": "src/HVOv9.sln",
        "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
        "dotnet.unitTests.runSettingsPath": "src/coverage.runsettings",
        // C# Development Settings
        "csharp.semanticHighlighting.enabled": true,
        "csharp.showOmnisharpLogOnError": true,
        "csharp.suppressDotnetInstallWarning": true,
        // Reduce MEF composition issues in dev containers
        "dotnet.server.suppressLspErrorToasts": true,
        "omnisharp.enableRoslynAnalyzers": true,
        "omnisharp.enableEditorConfigSupport": true,
        // Editor Configuration for C#
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit",
          "source.organizeImports": "explicit"
        },
        // File Associations for HVO project types
        "files.associations": {
          "*.razor": "razor",
          "*.cshtml": "razor",
          "*.runsettings": "xml"
        },
        // Terminal Configuration
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "args": [
              "--login"
            ]
          }
        },
        // Git Configuration
        "git.enableSmartCommit": true,
        "git.confirmSync": false
      },
      "extensions": [
        // .NET Development Extensions (essential for container-based development)
        "ms-dotnettools.csdevkit", // C# Dev Kit (includes IntelliSense, debugging, testing)
        "ms-dotnettools.csharp", // C# language support
        "ms-dotnettools.vscode-dotnet-runtime", // .NET Runtime support
        // ASP.NET Core and Blazor Development
        "ms-dotnettools.blazorwasm-companion", // Blazor WebAssembly debugging
        // Database and Entity Framework
        "ms-mssql.mssql", // SQL Server support for EF development
        // Container and Development Tools
        "ms-vscode.powershell", // PowerShell support for scripts
        // Git and Collaboration
        "GitHub.vscode-pull-request-github", // GitHub PR integration
        "GitHub.remotehub", // GitHub remote repository support
        "ms-vsliveshare.vsliveshare", // Live Share for collaboration
        // Azure and Cloud Development  
        "ms-azuretools.vscode-azure-mcp-server", // Azure MCP integration
        "ms-azuretools.vscode-docker", // Docker support for containerized apps
        // IoT and Hardware Development (HVO-specific)
        "ms-vscode.cpptools", // C/C++ for hardware interface development
        // Productivity Extensions
        "redhat.vscode-xml" // XML support for project files
      ]
    }
  },
  "forwardPorts": [
    5136, // HTTP development server
    7151, // HTTPS development server  
    5000, // Alternative ASP.NET Core HTTP port
    5001, // Alternative ASP.NET Core HTTPS port
    8080, // Common development port for services
    3000 // Common frontend development port
  ],
  "mounts": [
    {
      "type": "volume",
      "source": "x509stores",
      "target": "/home/vscode/.dotnet/corefx/cryptography/x509stores"
    }
  ],
  "postStartCommand": "sudo chown -R vscode:vscode /home/vscode/.dotnet 2>/dev/null || true",
  "postCreateCommand": "bash scripts/post-create.sh"
}